export BROWSER=chromium
export TERM=xterm-kitty
export QT_QPA_PLATFORM="wayland;xcb"
export QT_QPA_PLATFORMTHEME="qt6ct"
export ELECTRON_OZONE_PLATFORM_HINT=wayland
export HYPRCURSOR_THEME="Bibata-Modern-Ice"
export HYPRCURSOR_SIZE=24
export XCURSOR_THEME="Bibata-Modern-Ice"
export XCURSOR_SIZE=24

# Hybrid Intel/NVIDIA (Optimus) laptop: only force the NVIDIA GBM backend on
# pure-NVIDIA systems, matching /etc/profile.d/Hyprland.sh's own check.
# Forcing it unconditionally here (while the Intel iGPU is the active display
# GPU) breaks EGLImage/dmabuf sharing in Chromium/Ozone and causes scroll lag.
if [ -d /sys/module/nvidia ] && [ ! -d /sys/module/i915 ] && [ ! -d /sys/module/amdgpu ]; then
	export GBM_BACKEND=nvidia-drm
	export __GLX_VENDOR_LIBRARY_NAME=nvidia
	export LIBVA_DRIVER_NAME=nvidia
fi

export __GL_GSYNC_ALLOWED=1 # Controls if G-Sync capable monitors should use Variable Refresh Rate (VRR)
export GDK_BACKEND=wayland,x11,*
export CLUTTER_BACKEND=wayland
export SDL_VIDEODRIVER=wayland
